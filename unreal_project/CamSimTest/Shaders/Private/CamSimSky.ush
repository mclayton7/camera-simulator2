// Night sky terms for M_SkyDome (ROADMAP 6A), included by its NightSky Custom node (scripts/sky/make_sky_material.py).
// Mirrors Environment/NightIllumination.cpp expression for expression: CamSimSkyAirMass =
// FNightIllumination::KastenYoungAirMass, CamSimSkyTransmittance = FNightIllumination::Transmittance
// (horizon cut-off -0.5 deg, K = k_V 0.172 from MPC_Sky Floor.z), CamSimMoonDisc = FMoonDisc::Radiance
// (Environment/MoonSurface.cpp; u toward the sun, z toward the viewer) x the disc luminance scale. Change both together.
#pragma once

// Kasten-Young relative air mass at elevation asin(SinEl); 40 at or below -0.5 deg.
float CamSimSkyAirMass(float SinEl)
{
	float ElDeg = degrees(asin(clamp(SinEl, -1.0, 1.0)));
	if (ElDeg <= -0.5) return 40.0;
	return 1.0 / (SinEl + 0.50572 * pow(ElDeg + 6.07995, -1.6364));
}

// Atmospheric transmittance 10^(-0.4 K X) along a direction of sine elevation SinEl; 0 below -0.5 deg.
float CamSimSkyTransmittance(float SinEl, float K)
{
	float ElDeg = degrees(asin(clamp(SinEl, -1.0, 1.0)));
	if (ElDeg < -0.5) return 0.0;
	return pow(10.0, -0.4 * K * CamSimSkyAirMass(SinEl));
}

// The disc-plane direction toward the sun; with the sun exactly behind or in front of the moon (eclipse, conjunction) any
// perpendicular (the shading is then symmetric about the line of sight). Mirrors FMoonDisc::DiscBasis.
float3 CamSimMoonRight(float3 MoonDir, float3 SunDir)
{
	float3 P = SunDir - dot(SunDir, MoonDir) * MoonDir;
	if (dot(P, P) < 1e-12) P = cross(MoonDir, abs(MoonDir.z) < 0.9 ? float3(0, 0, 1) : float3(1, 0, 0));
	return normalize(P);
}

// Moon disc luminance along view dir V: 0 outside the disc. Mirrors FMoonDisc::Radiance (Environment/MoonSurface.cpp):
// the disc point's surface normal N = u Right + v Up + nz (-MoonDir) (u toward the sun in the disc plane), lunar-Lambert
// reflectance 2 L mu0 / (mu0 + mu) + (1 - L) mu0 (McEwen; L = MoonParams.z, mu0 = N.SunDir, mu = nz) times the albedo
// map at N's selenographic coordinates (body axes AxisX/Y/Z from the IAU rotation model), sampled at LOD (G8: .r).
float CamSimMoonDisc(float3 V, float3 MoonDir, float3 SunDir, float AngRadius, float LumScale, float L,
	float3 AxisX, float3 AxisY, float3 AxisZ, Texture2D AlbedoTex, SamplerState AlbedoSampler, float Lod)
{
	float CosD = dot(V, MoonDir);
	if (CosD < cos(AngRadius)) return 0.0;
	float3 Right = CamSimMoonRight(MoonDir, SunDir);                        // toward the sun, in the disc plane
	float3 Up = cross(MoonDir, Right);
	float2 UV = float2(dot(V, Right), dot(V, Up)) / sin(AngRadius);
	float R2 = dot(UV, UV);
	if (R2 > 1.0) return 0.0;
	float Nz = sqrt(1.0 - R2);                                               // toward the viewer
	float3 N = UV.x * Right + UV.y * Up - Nz * MoonDir;
	float Mu0 = dot(N, SunDir);
	if (Mu0 <= 0.0) return 0.0;
	float Shade = 2.0 * L * Mu0 / (Mu0 + Nz) + (1.0 - L) * Mu0;
	float Lon = atan2(dot(N, AxisY), dot(N, AxisX));
	float Lat = asin(clamp(dot(N, AxisZ), -1.0, 1.0));
	float2 T = float2(Lon / (2.0 * PI) + 0.5, 0.5 - Lat / PI);
	return LumScale * AlbedoTex.SampleLevel(AlbedoSampler, T, Lod).r * Shade;
}

// Mip level for the albedo map: the view's pixel footprint (radians, from the view-direction derivatives, taken outside
// any branch) over one texel's angular size at the disc centre ((2 pi / width) x sin r).
float CamSimMoonLod(float PixelAngle, float AngRadius, float TexWidth)
{
	float TexelAngle = (2.0 * PI / TexWidth) * sin(AngRadius);
	return max(log2(max(PixelAngle, 1e-12) / max(TexelAngle, 1e-12)), 0.0);
}
