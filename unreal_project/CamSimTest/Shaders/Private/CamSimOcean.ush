// Gerstner sum mirroring FOceanWaves (Ocean/OceanWaves.cpp) expression for expression.
// P: plane coordinates (N, E) in metres. W[i] = (k, a, Q, phase), D[i] = (dN, dE).
// Fade: waves with lambda/4 < CellM are faded out (the grid can't carry them).
#pragma once

float CamSimOceanFade(float k, float CellM)
{
	const float Lambda = 6.28318530718 / max(k, 1e-6);
	return saturate(2.0 - 8.0 * CellM / Lambda);   // 1 below lambda/8, 0 at lambda/4
}

float3 CamSimOceanDisplacement(float2 P, float CellM, float4 W[4], float4 D[4])
{
	float3 Disp = 0;
	[unroll] for (int i = 0; i < 4; ++i)
	{
		const float Fade = CamSimOceanFade(W[i].x, CellM);
		const float Th = W[i].x * dot(D[i].xy, P) + W[i].w;
		const float S = sin(Th), C = cos(Th), Qa = W[i].z * W[i].y * Fade;
		Disp.x -= Qa * D[i].x * S;
		Disp.y -= Qa * D[i].y * S;
		Disp.z += W[i].y * Fade * C;
	}
	return Disp;   // (dN, dE, dZ) metres
}

float3 CamSimOceanNormal(float2 P, float CellM, float4 W[4], float4 D[4])
{
	float3 N = float3(0, 0, 1);
	[unroll] for (int i = 0; i < 4; ++i)
	{
		const float Fade = CamSimOceanFade(W[i].x, CellM);
		const float Th = W[i].x * dot(D[i].xy, P) + W[i].w;
		const float KA = W[i].x * W[i].y * Fade;
		N.x += D[i].x * KA * sin(Th);
		N.y += D[i].y * KA * sin(Th);
		N.z -= W[i].z * KA * cos(Th);
	}
	return normalize(N);   // (N, E, Up)
}

// ---------------------------------------------------------------------------
// Per-pixel shading (visual only; not mirrored on the CPU, which has no normals
// to match: Task 10's GPU test compares depth, i.e. the displacement above).
// ---------------------------------------------------------------------------

// Pixel footprint in metres on the sea plane. Pass it as CamSimOceanNormal's CellM:
// the normal is per pixel, so a wave's slope stays visible wherever a pixel resolves it
// (1 below lambda/8 of the footprint, 0 at lambda/4), even where the grid is too coarse
// to displace it.
float CamSimOceanFootprintM(float2 P)
{
	return max(length(ddx(P)), length(ddy(P)));
}

// Short capillary-gravity ripples (spec: "a small procedural ripple normal"): three fixed
// directions, deep-water dispersion w = sqrt(g k), slope amplitudes scaled by Strength
// (MPC Water.z). Returns the height gradient (dh/dN, dh/dE); footprint-faded like the waves.
static const float CamSimRippleLambda[3] = { 0.6, 1.3, 2.7 };
static const float CamSimRippleSlope[3]  = { 0.25, 0.2, 0.15 };
static const float2 CamSimRippleDir[3]   = { float2(0.940, 0.342), float2(-0.342, 0.940), float2(-0.643, -0.766) };

float2 CamSimOceanRippleGradient(float2 P, float FootM, float TimeS, float Strength)
{
	float2 G = 0;
	[unroll] for (int i = 0; i < 3; ++i)
	{
		const float k = 6.28318530718 / CamSimRippleLambda[i];
		const float Fade = CamSimOceanFade(k, FootM);
		const float Th = k * dot(CamSimRippleDir[i], P) - sqrt(9.80665 * k) * TimeS;
		G += CamSimRippleDir[i] * (Strength * CamSimRippleSlope[i] * Fade * cos(Th));
	}
	return G;
}

// Unit (N, E, Up) normal: Gerstner waves + ripples, all faded by the pixel footprint.
float3 CamSimOceanPixelNormal(float2 P, float TimeS, float RippleStrength, float4 W[4], float4 D[4])
{
	const float FootM = CamSimOceanFootprintM(P);
	float3 N = CamSimOceanNormal(P, FootM, W, D);
	const float2 G = CamSimOceanRippleGradient(P, FootM, TimeS, RippleStrength);
	return normalize(N / max(N.z, 1e-3) - float3(G, 0));
}

// Roughness: the slope variance of the waves and ripples a pixel can no longer resolve
// (faded out of the normal) turns into microfacet roughness instead of vanishing, so the
// distant sea is not a mirror. Base 0.08 (flat water).
float CamSimOceanRoughness(float2 P, float TimeS, float RippleStrength, float4 W[4], float4 D[4])
{
	const float FootM = CamSimOceanFootprintM(P);
	float Var = 0;
	[unroll] for (int i = 0; i < 4; ++i)
	{
		const float S = W[i].x * W[i].y;   // slope amplitude k a
		Var += 0.5 * S * S * (1.0 - CamSimOceanFade(W[i].x, FootM));
	}
	[unroll] for (int j = 0; j < 3; ++j)
	{
		const float S = RippleStrength * CamSimRippleSlope[j];
		Var += 0.5 * S * S * (1.0 - CamSimOceanFade(6.28318530718 / CamSimRippleLambda[j], FootM));
	}
	return clamp(sqrt(0.08 * 0.08 + 2.0 * Var), 0.08, 0.5);
}
